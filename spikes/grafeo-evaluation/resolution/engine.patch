+    /// Disposable P2 prototype: cap final result materialization without rewriting Cypher.
+    #[cfg(feature = "cypher")]
+    pub fn execute_cypher_bounded(
+        &self,
+        query: &str,
+        params: std::collections::HashMap<String, Value>,
+        row_cap: usize,
+    ) -> Result<QueryResult> {
+        use crate::query::{
+            binder::Binder, optimizer::Optimizer, processor::substitute_params,
+            translators::cypher,
+        };
+        use grafeo_common::utils::error::{Error, QueryError, QueryErrorKind};
+        let mut logical = match cypher::translate_full(query)? {
+            cypher::CypherTranslationResult::Plan(plan) => plan,
+            _ => {
+                self.require_permission(crate::auth::StatementKind::Admin)?;
+                return Err(Error::Query(QueryError::new(
+                    QueryErrorKind::Semantic, "prototype bounded API supports query plans only",
+                )));
+            }
+        };
+        if logical.root.has_mutations() {
+            self.require_permission(crate::auth::StatementKind::Write)?;
+            return Err(Error::Query(QueryError::new(
+                QueryErrorKind::Semantic, "bounded API does not execute writes",
+            )));
+        }
+        self.require_permission(crate::auth::StatementKind::Read)?;
+        let mut merged = logical.default_params.clone();
+        merged.extend(params);
+        substitute_params(&mut logical, &merged)?;
+        Binder::new().bind(&logical)?;
+        let active = self.active_store();
+        let optimized = Optimizer::from_graph_store(active.as_ref()).optimize(logical)?;
+        if optimized.explain || optimized.profile {
+            return Err(Error::Query(QueryError::new(
+                QueryErrorKind::Semantic, "prototype bounded API excludes EXPLAIN/PROFILE",
+            )));
+        }
+        let (epoch, transaction) = self.get_transaction_context();
+        let planner = self.create_planner_for_store(active, epoch, transaction);
+        let mut physical = planner.plan(&optimized)?;
+        self.make_executor(physical.columns.clone())
+            .execute_with_limit(physical.operator.as_mut(), row_cap)
+    }
+
