+    /// Prototype candidate-only metadata; durability is established by close, not WAL commit.
+    pub fn set_application_metadata(&self, key: String, value: String) -> Result<()> {
+        if self.is_read_only() {
+            return Err(Error::Internal("cannot set metadata on read-only database".into()));
+        }
+        self.catalog.application_metadata.write().insert(key, value);
+        Ok(())
+    }
+
+    /// Prototype metadata independent of projected graph nodes.
+    pub fn application_metadata(&self, key: &str) -> Option<String> {
+        self.catalog.application_metadata.read().get(key).cloned()
+    }
